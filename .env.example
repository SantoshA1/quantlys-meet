# =============================================================================
# Quantlys Meeting — environment template
# Copy to .env.local for local dev, or paste into Vercel → Settings → Env Vars.
# Never commit real values. No production secrets belong in this file.
# =============================================================================

# --- Required for a joinable meeting (LiveKit Cloud or your own livekit-server)
LIVEKIT_URL=wss://yourproject.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Browser-facing WebSocket URL (often same as LIVEKIT_URL)
NEXT_PUBLIC_LIVEKIT_URL=wss://yourproject.livekit.cloud
# Optional alias some routes still accept
# LIVEKIT_WS_URL=

# --- Required for auth, meeting history, RLS (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=

# --- Required for live captions / transcription (Deepgram)
DEEPGRAM_API_KEY=

# --- Required for notes, PRD, Memory package, search write-up, digest
# Prefer OpenRouter (multi-model) OR OpenAI. One is enough.
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# Optional model overrides (OpenRouter-style ids for OpenRouter; OpenAI ids for OpenAI)
# NOTES_MODEL=anthropic/claude-sonnet-4.5
# AGENT_MODEL=anthropic/claude-sonnet-4.5

# --- Recording storage: NOT needed. The host's browser records and uploads to
# the private Supabase Storage bucket `recordings` (created by supabase/schema.sql).
# S3_* are only read by a legacy LiveKit Egress path; leave them unset.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# --- App URL (Deepgram callbacks, invite links, digests, share URLs)
APP_URL=https://your-app.vercel.app
# Optional browser-facing mirror used when APP_URL is unset
# NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# --- Cron (Vercel Cron hits /api/cron/cleanup nightly and /api/digest/weekly on Mondays)
# Recordings older than this many days are DELETED from storage (video, audio,
# board, transcript). Leave unset or 0 to keep recordings until the host deletes them.
# Preview what the next run would delete: GET /api/cron/cleanup?dry=1 with the secret.
RECORDING_RETENTION_DAYS=30
# Shared secret: Authorization: Bearer <CRON_SECRET>. Both routes refuse to run without it.
CRON_SECRET=

# --- Host / guest policy
# Domain auto-join for hosts (optional)
ALLOWED_EMAIL_DOMAIN=
# Unsigned guests can mint a room token (product default: on)
ALLOW_GUEST_JOIN=true
# UI mirror for the landing guest-join card — keep in sync with ALLOW_GUEST_JOIN
NEXT_PUBLIC_ALLOW_GUEST_JOIN=true

# --- Mail (invites, notes, digest, optional "Email the spec") — optional
RESEND_API_KEY=
RESEND_FROM=Quantlys Meeting <onboarding@resend.dev>
# Optional. Signed unsubscribe/download tokens fall back to CRON_SECRET.
# SPEC_EMAIL_SECRET=

# --- Dev / audit only (not needed in production)
# QM_CHROME=
# QM_SHOTS=

# --- PRD export: direct push to GitHub / Linear / Jira / Notion — optional
# 32 random bytes, base64 or hex:  openssl rand -base64 32
# Encrypts each host's integration tokens at rest (AES-256-GCM). Without it,
# or without supabase/migrations/20261019_integrations.sql, direct push stays
# hidden and the no-setup export (copy / download / prefilled links) still works.
# Changing it later means hosts must reconnect their integrations.
INTEGRATIONS_ENCRYPTION_KEY=
