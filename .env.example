LIVEKIT_URL=wss://yourproject.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
NEXT_PUBLIC_LIVEKIT_URL=wss://yourproject.livekit.cloud
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only, NEVER NEXT_PUBLIC_
DEEPGRAM_API_KEY=
S3_BUCKET=quantlys-recordings
S3_REGION=auto
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_ACCESS_KEY=
S3_SECRET_KEY=
APP_URL=https://your-app.vercel.app  # for Deepgram callback + webhooks
RECORDING_RETENTION_DAYS=30          # 30 | 60 | 90
CRON_SECRET=
ALLOWED_EMAIL_DOMAIN=team.com        # domain auto-join
ALLOW_GUEST_JOIN=false               # true for THIS WEEK'S test, then OFF
NEXT_PUBLIC_ALLOW_GUEST_JOIN=false   # mirror, for the share-bar link mode

# Mail (invites, notes, digest, and the optional "Email the spec" send)
RESEND_API_KEY=
RESEND_FROM=Quantlys Meeting <onboarding@resend.dev>
# Optional. Signed unsubscribe/download tokens fall back to CRON_SECRET.
SPEC_EMAIL_SECRET=
